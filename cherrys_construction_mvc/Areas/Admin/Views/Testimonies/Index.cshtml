@model IEnumerable<TestimonyResponce>

@{
    ViewData["Title"] = Breadcrumb.TestimoniesTitle;
}

<!-- ======= Breadcrumbs ======= -->
<div class="breadcrumbs d-flex align-items-center" style="background-image: url('/assets/img/breadcrumbs-bg.jpg');">
    <div class="container position-relative d-flex flex-column align-items-center" data-aos="fade">

        <h2>@Breadcrumb.TestimoniesTitle</h2>
        <ol>
            <li><a asp-area="@Breadcrumb.HomeArea" asp-controller="@Breadcrumb.HomeController" asp-action="Index">@Breadcrumb.HomeTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.AdminController" asp-action="Index">@Breadcrumb.AdminTitle</a></li>
            <li>@Breadcrumb.TestimoniesTitle</li>
        </ol>

    </div>
</div><!-- End Breadcrumbs -->

<section id="list" class="list">
    <div class="container" data-aos="fade-up">

        <div class="section-header">
            <h2>@Breadcrumb.TestimoniesTitle</h2>
        </div>

        @if (Model.Any())
        {
            <div class="text-center">
                <div class="container" data-aos="fade-up">

                    @foreach (var item in Model)
                    {
                        <div class="row gy-4 list-item featured mt-4" data-aos="fade-up" data-aos-delay="200">
                            <div class="col-lg-4 align-content-center justify-content-center">
                                <img class="img-fluid" style="clip-path:none;border-radius:20px;" src="@item.ImageLink" />
                            </div>
                            <div class="col-lg-8 d-flex align-items-center justify-content-center">
                                <div>
                                    <h3>@item.Name</h3>
                                    <h4 style="color:gray">@item.Project.Title</h4>
                                    <h5>@item.Position</h5>
                                    @Html.Raw(@item.Description)
                                </div>
                            </div>

                            <div class="flex-btn-container-row">
                                <a class="flex-btn-row edit-btn text-center" asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.TestimoniesController"
                                   asp-action="@Breadcrumb.Edit" asp-route-id="@item.Id" class="readmore stretched-link">
                                    <span>@Breadcrumb.Edit</span><i class="fa-regular fa-pen-to-square"></i>
                                </a>
                                <a class="flex-btn-row delete-btn text-center" asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.TestimoniesController"
                                   asp-action="@Breadcrumb.Delete" asp-route-id="@item.Id" class="readmore stretched-link">
                                    <span>@Breadcrumb.Delete</span><i class="fa-regular fa-trash-can"></i>
                                </a>
                                <br>
                            </div>

                        </div>

                        <!-- End Members Item -->
                    }
                </div>

            </div>
        }

        <div class="text-center col-12 add-btn-container" data-aos="fade-up" data-aos-delay="100">
            <a class="add-button" asp-area="@Breadcrumb.AdminArea" asp-action="Create"><i class="bi bi-plus"></i></a>
        </div>
       
    </div>
</section>


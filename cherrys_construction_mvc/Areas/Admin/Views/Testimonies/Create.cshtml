@model TestimonyRequest

@{
    ViewData["Title"] = Breadcrumb.TestimoniesTitle;
}

<!-- ======= Breadcrumbs ======= -->
<div class="breadcrumbs d-flex align-items-center" style="background-image: url('assets/img/breadcrumbs-bg.jpg');">
    <div class="container position-relative d-flex flex-column align-items-center" data-aos="fade">

        <h2>@Breadcrumb.TestimoniesTitle</h2>
        <ol>
            <li><a asp-area="@Breadcrumb.HomeArea" asp-controller="@Breadcrumb.HomeController" asp-action="Index">@Breadcrumb.HomeTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.AdminController" asp-action="Index">@Breadcrumb.AdminTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.TestimoniesController" asp-action="Index">@Breadcrumb.TestimoniesTitle</a></li>
            <li>@Breadcrumb.Create</li>
        </ol>

    </div>
</div><!-- End Breadcrumbs -->


<section id="list" class="list">
    <div class="row">
        <div class="list-container">

            <!-- Multi Columns Form -->
            <form enctype="multipart/form-data" method="post">
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-5 col-md-5">
                                <div class="form-floating mb-2">
                                    <input id="obj1" asp-for="Name" class="form-control" placeholder="Full Name" />
                                    <label for="obj1" asp-for="Name">Full Name</label>
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-4 col-md-4">
                                <div class="form-floating mb-2">
                                    <input id="obj2" asp-for="Position" class="form-control" placeholder="Position ex. CEO, Owner, Etc." />
                                    <label for="obj2" asp-for="Position">Position</label>
                                    <span asp-validation-for="Position" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-3">
                                <div class="form-floating">
                                    <input id="obj3" asp-for="Stars" class="form-control" />
                                    <label for="obj3" asp-for="Stars">Rating 1 - 5 </label>
                                    <span asp-validation-for="Stars" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 pt-3 pb-3">
                            <textarea asp-for="Description" class="form-control"></textarea>
                        </div>
                        <div class="col-12">
                            <p class="text-info">Before uploading make sure photo is square</p>
                            <input id="obj4" asp-for="Image" type="file" class="form-control" />
                            <label for="obj4" asp-for="Image"></label>
                            <span asp-validation-for="Image" class="text-danger"></span>
                        </div>
                        @if (Model.Projects != null)
                        {
                            <div class="col-12 pt-2">

                                <label class="text-info" asp-for="ProjectId">Add Project or leave blank</label>
                                <select asp-for="ProjectId" class="form-select">
                                    <option disabled selected>--Select Project--</option>
                                    @if (Model.Projects.Any())
                                    {
                                        @foreach (var a in Model.Projects)
                                        {
                                            <option value="@a.Id">@a.Title</option>
                                        }
                                    }
                                    else
                                    {
                                        <select asp-for="ProjectId" class="form-select">
                                            <option disabled selected>--Disabled--</option>
                                        </select>
                                    }
                                    <span asp-validation-for="ProjectId" class="text-danger"></span>
                                </select>

                            </div>
                        }
                        else
                        {
                            <select asp-for="ProjectId" class="form-select">
                                <option disabled selected>--Disabled--</option>
                            </select>
                        }
                        <div class="mt-3">
                            <a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.TestimoniesController" asp-action="Index" class="back-btn">@Breadcrumb.Back</a>
                            <button type="submit" class="create-btn">@Breadcrumb.Create</button>
                        </div>

                    </div>
                </div>

            </form><!-- End Multi Columns Form -->

        </div>
    </div>
</section>


@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}
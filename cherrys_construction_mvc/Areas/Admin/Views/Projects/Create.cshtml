@model ProjectRequest

@{
    ViewData["Title"] = Breadcrumb.ProjectsTitle;
    DateTime Time = DateTime.Today;
}

<!-- ======= Breadcrumbs ======= -->
<div class="breadcrumbs d-flex align-items-center" style="background-image: url('/assets/img/breadcrumbs-bg.jpg');">
    <div class="container position-relative d-flex flex-column align-items-center" data-aos="fade">
        <h2>@Breadcrumb.ProjectsDashboardTitle</h2>
        <ol>
            <li><a asp-area="@Breadcrumb.HomeArea" asp-controller="@Breadcrumb.HomeController" asp-action="Index">@Breadcrumb.HomeTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.AdminController" asp-action="Index">@Breadcrumb.AdminTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.AdminController" asp-action="Projects">@Breadcrumb.ProjectsDashboardTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.ProjectsController" asp-action="Index">@Breadcrumb.ProjectsTitle</a></li>
            <li>@Breadcrumb.Edit</li>
        </ol>
    </div>
</div><!-- End Breadcrumbs -->

<section id="list" class="list">
    <div class="row">
        <div class="list-container">

            @{
                Model.ProjectEndDate = Time;
                Model.ProjectStartDate = Time;
            }
            <!-- Multi Columns Form -->
            <form enctype="multipart/form-data" method="post">
                <div class="card">
                    <div class="card-body row">
                        <div class="col-md-6 mb-3">
                            <div class="form-floating">
                                <input id="obj1" asp-for="ClientName" class="form-control" placeholder="Client or Company Name" />
                                <label for="obj1" asp-for="ClientName">Client or Company Name</label>
                                <span asp-validation-for="ClientName" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-floating">
                                <input id="obj4" asp-for="Title" class="form-control" placeholder="Project Title" />
                                <label for="obj4" asp-for="Title">Project Title</label>
                                <span asp-validation-for="Title" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-6 mb-3">
                            <div class="form-floating">         
                                
                                <input id="obj2" asp-for="ProjectStartDate" class="form-control" />
                                <label for="obj2" asp-for="ProjectStartDate">Project Start Date</label>
                                <span asp-validation-for="ProjectStartDate" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-6 mb-3">
                            <div class="form-floating">
                                <input id="obj3" asp-for="ProjectEndDate" class="form-control" />
                                <label for="obj3" asp-for="ProjectEndDate">Project End Date</label>
                                <span asp-validation-for="ProjectEndDate" class="text-danger"></span>
                            </div>
                        </div>
                        @if (Model.Tags.Any())
                        {
                            <div class="col-sm-6 mb-3">
                                <div class="d-inline-block row">
                                    @foreach (var i in @Model.Tags)
                                    {
                                        <div class="d-inline-flex">
                                            <div class="form-check">
                                                <input id="@i.Value" class="form-check-input" type="checkbox" name="skill" value="@i.Value" checked="@i.Selected" />
                                                <label asp-for="TagIds" class="form-check-label" for="@i.Value">
                                                    @i.Text
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        <div class="col-sm-6 mb-3">
                            <label asp-for="ServiceTypeId" />
                            <select asp-for="ServiceTypeId" class="form-select">
                                @foreach (var item in @Model.ServiceTypes)
                                {
                                    <option value="@item.Id">@item.Title</option>
                                }
                            </select>
                            <span asp-validation-for="ServiceTypeId" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description">Description</label>
                            <textarea asp-for="Description" class="form-control"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                        
                        <div class="col-12">
                            <label asp-for="Files">Images</label>
                            <input asp-for="Files" type="file" multiple class="form-control" />
                            <span asp-validation-for="Files" class="text-danger"></span>
                        </div>

                        <div class="mt-3 col-sm-12">
                            <a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.ProjectsController" asp-action="Index" class="back-btn">@Breadcrumb.Back</a>
                            <button type="submit" class="create-btn">@Breadcrumb.Create</button>
                        </div>

                    </div>
                </div>

            </form><!-- End Multi Columns Form -->

        </div>
    </div>
</section>



@section Scripts {

    @{
        <partial name="_ValidationScriptsPartial" />
    }
}

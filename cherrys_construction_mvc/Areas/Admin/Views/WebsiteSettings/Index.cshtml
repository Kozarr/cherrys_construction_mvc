@model CompanyInfoResponce

@{
    ViewData["Title"] = Breadcrumb.WebsiteSettingsTitle;
}

<!-- ======= Breadcrumbs ======= -->
<div class="breadcrumbs d-flex align-items-center" style="background-image: url('/assets/img/breadcrumbs-bg.jpg');">
    <div class="container position-relative d-flex flex-column align-items-center" data-aos="fade">

        <h2>@Breadcrumb.WebsiteSettingsTitle</h2>
        <ol>
            <li><a asp-area="@Breadcrumb.HomeArea" asp-controller="@Breadcrumb.HomeController" asp-action="Index">@Breadcrumb.HomeTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.AdminController" asp-action="Index">@Breadcrumb.AdminTitle</a></li>
            <li>@Breadcrumb.WebsiteSettingsTitle</li>
        </ol>

    </div>
</div><!-- End Breadcrumbs -->

<section id="website-settings" class="website-settings">
    <div class="container" data-aos="fade-up">

        <div class="section-header">
            <h2>@Breadcrumb.WebsiteSettingsTitle</h2>
        </div>

        @if (Model == null)
        {
            <div class="col-12 add-btn-container text-center" data-aos="fade-up" data-aos-delay="100">
                <a class="add-button" asp-area="@Breadcrumb.AdminArea" asp-action="Create"><i class="bi bi-plus"></i></a>
            </div>
        }
        else
        {
            <div class="web-container" data-aos="fade-up" data-aos-delay="200">
                <div class="img-container">
                    @if (!string.IsNullOrWhiteSpace(Model.NavigationImageURL))
                    {
                        <div class="img-div">
                            <img src="@Model.NavigationImageURL" class="img-fluid">
                            <h5>Header</h5>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.FooterImageURL))
                    {
                        <div class="img-div">
                            <img src="@Model.FooterImageURL" class="img-fluid">
                            <h5>Footer</h5>
                        </div>
                    }
                    
                </div>
                <div class="web-content">
                    <h4>Business Name: @Model.CompanyName</h4>
                    <h4>Email: @Model.CompanyEmail</h4>
                    <h4>Phone: @Model.CompanyPhoneNumber</h4>
                </div>
                
            </div>

            <div class="flex-btn-container-row pt-2">
                <a class="flex-btn-row edit-btn text-center" asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.WebsiteSettingsController"
                   asp-action="@Breadcrumb.Edit" asp-route-id="@Model.Id" class="readmore stretched-link">
                    <span>@Breadcrumb.Edit</span><i class="fa-regular fa-pen-to-square"></i>
                </a>
                <br>
            </div>
        }
    </div>
</section>


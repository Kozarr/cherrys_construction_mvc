@model CompanyInfoResponce

@{
    ViewData["Title"] = Breadcrumb.WebsiteSettingsTitle;
}

<!-- ======= Breadcrumbs ======= -->
<div class="breadcrumbs d-flex align-items-center" style="background-image: url('/assets/img/breadcrumbs-bg.jpg');">
    <div class="container position-relative d-flex flex-column align-items-center" data-aos="fade">

        <h2>@Breadcrumb.WebsiteSettingsTitle</h2>
        <ol>
            <li><a asp-area="@Breadcrumb.HomeArea" asp-controller="@Breadcrumb.HomeController" asp-action="Index">@Breadcrumb.HomeTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.AdminController" asp-action="Index">@Breadcrumb.AdminTitle</a></li>
            <li>@Breadcrumb.WebsiteSettingsTitle</li>
        </ol>

    </div>
</div><!-- End Breadcrumbs -->

<section id="list" class="list">
    <div class="container" data-aos="fade-up">

        <div class="section-header">
            <h2>@Breadcrumb.WebsiteSettingsTitle</h2>
        </div>

        @if (Model == null)
        {
            <div class="col-12 add-btn-container text-center" data-aos="fade-up" data-aos-delay="100">
                <a class="add-button" asp-area="@Breadcrumb.AdminArea" asp-action="Create"><i class="bi bi-plus"></i></a>
            </div>
        }
        else
        {
            <div class="text-center pt-5 pb-5">
                <div class="container" data-aos="fade-up">

                    <div class="row gy-4 list-item featured mt-4" data-aos="fade-up" data-aos-delay="200">
                        <div class="col-md-12 d-flex">
                            <div class="col-4" style="padding-left:10px;">
                                <div class="mb-3">
                                    @if (Model.NavigationImageURL != null)
                                    {
                                        <img src="@Model.NavigationImageURL" class="img-fluid" style="clip-path:none;">
                                    }
                                </div>
                                <div>
                                    @if (Model.FooterImageURL != null)
                                    {
                                        <img src="@Model.FooterImageURL" class="img-fluid" style="clip-path:none;">
                                    }
                                </div>

                            </div>
                            <div class="col-8">
                                <h3>@Model.CompanyName</h3>
                                <h4>@Model.CompanyEmail</h4>
                                <h4>@Model.CompanyPhoneNumber</h4>

                                <br />
                                @if (Model.FaceBookLink != null)
                                {
                                    <h5>@Model.FaceBookLink</h5>
                                }
                                @if (Model.InstagramLink != null)
                                {
                                    <h5>@Model.InstagramLink</h5>
                                }
                                @if (Model.YoutubeLink != null)
                                {
                                    <h5>@Model.YoutubeLink</h5>
                                }
                                @if (Model.LinkedInLink != null)
                                {
                                    <h5>@Model.LinkedInLink</h5>
                                }
                                @if (Model.TwitterLink != null)
                                {
                                    <h5>@Model.TwitterLink</h5>
                                }
                            </div>
                        </div>
                        <div class="col-md-12 d-flex flex-row justify-content-around align-items-center">
                            <div class="m-auto">
                                <a class="edit-btn" asp-area="@Breadcrumb.AdminArea" asp-action="Edit" asp-route-id="@Model.Id">@Breadcrumb.Edit</a>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>
</section>


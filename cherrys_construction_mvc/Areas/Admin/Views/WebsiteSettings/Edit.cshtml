@model CompanyInfoRequestViewModel

@{
    ViewData["Title"] = Breadcrumb.WebsiteSettingsTitle;
}

<!-- ======= Breadcrumbs ======= -->
<div class="breadcrumbs d-flex align-items-center" style="background-image: url('/assets/img/breadcrumbs-bg.jpg');">
    <div class="container position-relative d-flex flex-column align-items-center" data-aos="fade">

        <h2>@Breadcrumb.WebsiteSettingsTitle</h2>
        <ol>
            <li><a asp-area="@Breadcrumb.HomeArea" asp-controller="@Breadcrumb.HomeController" asp-action="Index">@Breadcrumb.HomeTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.AdminController" asp-action="Index">@Breadcrumb.AdminTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.WebsiteSettingsController" asp-action="Index">@Breadcrumb.WebsiteSettingsTitle</a></li>
            <li>@Breadcrumb.Edit</li>
        </ol>

    </div>
</div>
<!-- End Breadcrumbs -->

<section id="website-settings" class="website-settings">
    <div class="container">
        <div class="web-form-container">

            <form method="post" asp-action="Edit" enctype="multipart/form-data">

                <div class="img-container">
                    <div class="img-div">
                        @if (!string.IsNullOrWhiteSpace(Model.CompanyInfo.NavigationImageURL))
                        {
                            <img class="img-fluid" src="@Model.CompanyInfo.NavigationImageURL" />
                            <h5>Header</h5>
                        }
                        <div class="file-input">
                            <input asp-for="NavigationImage" type="file" class="form-control" value="Header Image" />
                            <span asp-validation-for="NavigationImage" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="img-div">
                        @if (!string.IsNullOrWhiteSpace(Model.CompanyInfo.FooterImageURL))
                        {
                            <img class="img-fluid" src="@Model.CompanyInfo.FooterImageURL" />
                            <h5>Footer</h5>
                        }
                        <div class="file-input">
                            <input asp-for="FooterImage" type="file" class="form-control" />
                            <span asp-validation-for="FooterImage" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="warning-container">
                    <h8 class="text-danger">This email needs to be registered with SendGrid to work.</h8>
                </div>
                <div class="web-form">
                    <div class="input-card web-form-input">
                        <div class="form-floating">
                            <input asp-for="CompanyInfo.CompanyEmail" id="obj2" class="form-control" type="email" placeholder="Company Email" />
                            <label asp-for="CompanyInfo.CompanyEmail" for="obj2">Email</label>
                            <span asp-validation-for="CompanyInfo.CompanyEmail" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="web-form-input">
                        <div class="form-floating">
                            <input asp-for="CompanyInfo.CompanyName" id="obj1" class="form-control" placeholder="Company Name" />
                            <label asp-for="CompanyInfo.CompanyName" for="obj1">Business Name</label>
                            <span asp-validation-for="CompanyInfo.CompanyName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="web-form-input">
                        <div class="form-floating">
                            <input asp-for="CompanyInfo.CompanyPhoneNumber" id="obj3" class="form-control" placeholder="Company Phone Number" />
                            <label asp-for="CompanyInfo.CompanyPhoneNumber" for="obj3">Phone Number</label>
                            <span asp-validation-for="CompanyInfo.CompanyPhoneNumber" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="web-form-input">
                        <div class="form-floating">
                            <input asp-for="CompanyInfo.SendButton" id="obj5" class="form-control" placeholder="Send Button" />
                            <label asp-for="CompanyInfo.SendButton" for="obj5">Contact Page - Form - Send Button (Text)</label>
                            <span asp-validation-for="CompanyInfo.SendButton" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="web-form-input">
                        <div class="form-floating">
                            <input asp-for="CompanyInfo.ServiceArea" id="obj4" class="form-control" placeholder="Service Area" />
                            <label asp-for="CompanyInfo.ServiceArea" for="obj4">Servicing Areas</label>
                            <span asp-validation-for="CompanyInfo.ServiceArea" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="web-form-input">
                        <div class="form-floating">
                            <input asp-for="CompanyInfo.FaceBookLink" id="obj6" class="form-control" placeholder="FaceBook Link" />
                            <label asp-for="CompanyInfo.FaceBookLink" for="obj6">FaceBook Link</label>

                        </div>
                    </div>
                    <div class="web-form-input">
                        <div class="form-floating">
                            <input asp-for="CompanyInfo.InstagramLink" id="obj7" class="form-control" placeholder="Instagram Link" />
                            <label asp-for="CompanyInfo.InstagramLink" for="obj7">Instagram Link</label>

                        </div>
                    </div>
                    <div class="web-form-input">
                        <div class="form-floating">
                            <input asp-for="CompanyInfo.YoutubeLink" id="obj8" class="form-control" placeholder="Youtube Link" />
                            <label asp-for="CompanyInfo.YoutubeLink" for="obj8">Youtube Link</label>

                        </div>
                    </div>
                    <div class="web-form-input">
                        <div class="form-floating">
                            <input asp-for="CompanyInfo.LinkedInLink" id="obj9" class="form-control" placeholder="LinkedIn Link" />
                            <label asp-for="CompanyInfo.LinkedInLink" for="obj9">LinkedIn Link</label>

                        </div>
                    </div>
                    <div class="web-form-input">
                        <div class="form-floating">
                            <input asp-for="CompanyInfo.TwitterLink" id="obj333" class="form-control" placeholder="Twitter Link" />
                            <label asp-for="CompanyInfo.TwitterLink" for="obj333">Twitter Link</label>
                        </div>
                    </div>
                </div>

                <div class="mt-3 text-center">
                    <a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.WebsiteSettingsController" asp-action="Index" class="back-btn">@Breadcrumb.Back</a>
                    <button type="submit" class="edit-btn">@Breadcrumb.Save</button>
                </div>

            </form><!-- End Multi Columns Form -->
        </div>
    </div>
</section>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}


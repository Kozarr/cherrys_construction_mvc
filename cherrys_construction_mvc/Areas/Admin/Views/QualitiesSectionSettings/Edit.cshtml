@model CompanyQualitySettingRequest

@{
    ViewData["Title"] = Breadcrumb.QualitiesSectionSettingsTitle;
}

<!-- ======= Breadcrumbs ======= -->
<div class="breadcrumbs d-flex align-items-center" style="background-image: url('assets/img/breadcrumbs-bg.jpg');">
    <div class="container position-relative d-flex flex-column align-items-center" data-aos="fade">

        <h2>@Breadcrumb.QualitiesSectionSettingsTitle</h2>
        <ol>
            <li><a asp-area="@Breadcrumb.HomeArea" asp-controller="@Breadcrumb.HomeController" asp-action="Index">@Breadcrumb.HomeTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.AdminController" asp-action="Index">@Breadcrumb.AdminTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.AdminController" asp-action="Projects">@Breadcrumb.QualitiesSectionSettingsDashboardTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.QualitiesSectionSettingsController" asp-action="Index">@Breadcrumb.QualitiesSectionSettingsTitle</a></li>
            <li>@Breadcrumb.Edit</li>
        </ol>

    </div>
</div><!-- End Breadcrumbs -->

<section id="list" class="list">
    <div class="row">
        <div class="list-container">

            <!-- Multi Columns Form -->
            <form enctype="multipart/form-data" method="post" asp-action="Edit">
                <input hidden asp-for="@Model.ImageLink" />
                <div class="card">
                    <div class="card-body row">
                        @if (Model.ImageLink != null || Model.ImageLink != " ")
                        {
                            <div class="text-center mb-3">
                                <img src="@Model.ImageLink" class="img-fluid" style="clip-path:none; max-width: 400px;" />
                            </div>
                        }
                        <div class="col-md-12">
                            <div class="form-floating mb-3">
                                <input id="obj45" asp-for="@Model.Title" class="form-control" placeholder="Section Title" />
                                <label for="obj45" asp-for="@Model.Title">Section Title</label>
                                <span asp-validation-for="@Model.Title" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-12 mb-3">
                            <textarea asp-for="@Model.Description" class="form-control" placeholder="Description"></textarea>
                            <span asp-validation-for="@Model.Description" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <input asp-for="Image" type="file" class="form-control" />
                            <span asp-validation-for="Image" class="text-danger"></span>
                        </div>
                        <div class="mt-3">
                            <a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.QualitiesSectionSettingsController" asp-action="Index" class="back-btn">@Breadcrumb.Back</a>
                            <button type="submit" class="edit-btn">@Breadcrumb.Save</button>
                        </div>

                    </div>
                </div>

            </form><!-- End Multi Columns Form -->

        </div>
    </div>
</section>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}
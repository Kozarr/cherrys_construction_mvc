@using cherrys_construction_mvc.Helper;
@using cherrys_construction_mvc.ViewModels.Blog;
@model BlogVM

@{
    ViewData["Title"] = Breadcrumb.BlogPostsTitle;
}

<!-- ======= Breadcrumbs ======= -->
<div class="breadcrumbs d-flex align-items-center" style="background-image: url('/assets/img/breadcrumbs-bg.jpg');">
    <div class="container position-relative d-flex flex-column align-items-center" data-aos="fade">

        <h2>@Breadcrumb.BlogPostsTitle</h2>
        <ol>
            <li><a asp-area="@Breadcrumb.HomeArea" asp-controller="@Breadcrumb.HomeController" asp-action="Index">@Breadcrumb.HomeTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.AdminController" asp-action="Index">@Breadcrumb.AdminTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.AdminController" asp-action="Blogs">@Breadcrumb.BlogDashboardTitle</a></li>
            <li>@Breadcrumb.BlogPostsTitle</li>
        </ol>

    </div>
</div><!-- End Breadcrumbs -->
<!-- ======= Blog Section ======= -->
<section id="blog" class="blog">
    <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="blog-create-container">
            <a class="create-btn text-center"
               asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.BlogPostsController"
               asp-action="@Breadcrumb.Create">@Breadcrumb.Create Blog<i class="fa-solid fa-plus"></i></a>
        </div>
        <div class="blog-isotope" data-blog-filter="*" data-blog-layout="masonry" data-portfolio-sort="original-order">

            <ul class="blog-flters" data-aos="fade-up" data-aos-delay="100">
                @if(Model != null)
                {
                    @if (Model.Categories != null)
                    {
                        @if (Model.Categories.Any())
                        {
                            @foreach (var category in Model.Categories)
                            {
                                <li>
                                    <a asp-action="Index" asp-route-currentFilter="@category.Name">@category.Name</a>
                                </li>
                            }
                        }
                    }
                }               
                <li>
                    @Html.ActionLink("Date", "Index", new { sortOrder = ViewBag.DateSortParam })
                </li>
            </ul><!-- End Blog Flters -->

            <form asp-action="Index" method="get">
                <div class="form-actions no-color search-form">

                    <input class="form-control" type="text" name="SearchString" value="@ViewData["CurrentFilter"]" />
                    <button type="submit" title="Search"><i class="bi bi-search"></i></button>

                    <a class="btn search-btn" asp-action="Index">Clear</a>

                </div>
            </form>
            @if (Model != null)
            {
                @if (Model.Posts != null)
                {
                    @if (Model.Posts.Any())
                    {
                        <div class="posts-list">
                            @foreach (var post in Model.Posts)
                            {
                                <div class="post-item">
                                    <div class="post-img">
                                        @if (post.ImageLink != null)
                                        {
                                            <a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.BlogPostsController" 
                                            asp-action="@Breadcrumb.Edit" asp-route-id="@post.Id">
                                                <img src="@post.ImageLink" class="img-fluid" alt="Blog Image">
                                            </a>
                                        }
                                        <a class="date-display" asp-action="Index" asp-route-currentFilter="@post.CreatedDateString">
                                            <span class="post-date">@post.CreatedDateString</span>
                                        </a>                                    
                                    </div>

                                    <div class="post-content">
                                        <a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.BlogPostsController" 
                                        asp-action="@Breadcrumb.Edit" asp-route-id="@post.Id">
                                            <h3 class="post-title">@post.Title</h3>
                                        </a>
                                        <div class="meta">
                                            <div class="d-flex align-items-center">
                                                <i class="bi bi-person"></i> <span class="ps-2">@post.Author</span>
                                            </div>
                                            @if (post.BlogCategory != null)
                                            {
                                                <span class="px-3 text-black-50">/</span>
                                                <div class="d-flex align-items-center">
                                                    <i class="bi bi-folder"></i> <span class="ps-2"><a asp-action="Index" asp-route-currentFilter="@post.BlogCategory.Name">@post.BlogCategory.Name</a></span>
                                                </div>
                                            }
                                        </div>
                                        @if (post.UpdatedDateString != null)
                                        {
                                            <div class="meta d-flex align-items-center">
                                                <i class="bi bi-arrow-repeat"></i> <span class="ps-2">Updated : @post.UpdatedDateString</span>
                                            </div>
                                        }
                                        @Html.Raw(post.ShortDescription)
                                        <hr>

                                    </div>
                                    <div class="flex-btn-container">
                                        <a class="flex-btn edit-btn text-center" asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.BlogPostsController"
                                        asp-action="@Breadcrumb.Edit" asp-route-id="@post.Id" class="readmore stretched-link">
                                            <span>@Breadcrumb.Edit</span><i class="fa-regular fa-pen-to-square"></i>
                                        </a>
                                        <a class="flex-btn delete-btn text-center" asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.BlogPostsController"
                                        asp-action="@Breadcrumb.Delete" asp-route-id="@post.Id" class="readmore stretched-link">
                                            <span>@Breadcrumb.Delete</span><i class="fa-regular fa-trash-can"></i>
                                        </a>
                                        <br>
                                    </div>
                                </div>
                                <!-- End post list item -->
                            }
                        </div>

                        <!-- End blog posts list -->
                        var prevDisabled = !Model.Posts.HasPreviousPage ? "disabled" : "";
                        var nextDisabled = !Model.Posts.HasNextPage ? "disabled" : "";

                        <div class="pagination-container text-center">
                            @*  Pagination  *@
                            <ul>
                                <li>
                                    <a asp-action="Index"
                                    asp-route-sortOrder="@ViewData["CurrentSort"]"
                                    asp-route-pageNumber="@(Model.Posts.PageIndex - 1)"
                                    asp-route-currentFilter="@ViewData["CurrentFilter"]"
                                    class="btn @prevDisabled">
                                        PREVIOUS
                                    </a>
                                </li>
                                <li>
                                    <a asp-action="Index"
                                    asp-route-sortOrder="@ViewData["CurrentSort"]"
                                    asp-route-pageNumber="@(Model.Posts.PageIndex + 1)"
                                    asp-route-currentFilter="@ViewData["CurrentFilter"]"
                                    class="btn @nextDisabled">
                                        NEXT
                                    </a>
                                </li>

                            </ul>

                        </div>
                    }
                }
            }

            </div>
        </div>
    </section>

    <!-- End Blog Section -->

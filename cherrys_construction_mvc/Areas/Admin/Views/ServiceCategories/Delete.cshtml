@model ServiceTypeResponce

@{
    ViewData["Title"] = Breadcrumb.ServiceCategoriesTitle;
}

<!-- ======= Breadcrumbs ======= -->
<div class="breadcrumbs d-flex align-items-center" style="background-image: url('/assets/img/breadcrumbs-bg.jpg');">
    <div class="container position-relative d-flex flex-column align-items-center" data-aos="fade">

        <h2>@Breadcrumb.ServiceCategoriesTitle</h2>
        <ol>
            <li><a asp-area="@Breadcrumb.HomeArea" asp-controller="@Breadcrumb.HomeController" asp-action="Index">@Breadcrumb.HomeTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.AdminController" asp-action="Index">@Breadcrumb.AdminTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.AdminController" asp-action="Services">@Breadcrumb.ServicesDashboardTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.ServiceCategoriesController" asp-action="Index">@Breadcrumb.ServiceCategoriesTitle</a></li>
            <li>@Breadcrumb.Delete</li>
        </ol>

    </div>
</div><!-- End Breadcrumbs -->

<section class="list">
    <div class="row">
        <div class="list-container">

            <!-- Multi Columns Form -->
            <form enctype="multipart/form-data" method="post" asp-action="Delete">
                <div class="card">
                    <div class="card-body row">
                        @*<div class="p-5 w-50" style="background: url(@Model.ImageLink)">

                        </div>*@
                        <h2 class="card-title text-center">@Model.Title</h2>
                        <div class="col-lg-6 text-center">
                            <img class="img-square img-fluid" src="@Model.ImageLink" />
                        </div>
                        <div class="col-lg-6">
                            <textarea id="readonly" asp-for="@Model.Description" class="form-control"></textarea>
                        </div>
                        <div class="mt-3 text-center">
                            <a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.ServiceCategoriesController" asp-action="Index" class="back-btn">@Breadcrumb.Back</a>
                            <button type="submit" class="delete-btn">@Breadcrumb.Delete</button>
                        </div>

                    </div>
                </div>

            </form><!-- End Multi Columns Form -->

        </div>
    </div>
</section>

@model IEnumerable<ServiceTypeResponce>

@{
    ViewData["Title"] = Breadcrumb.ServiceCategoriesTitle;
}

<!-- ======= Breadcrumbs ======= -->
<div class="breadcrumbs d-flex align-items-center" style="background-image: url('/assets/img/breadcrumbs-bg.jpg');">
    <div class="container position-relative d-flex flex-column align-items-center" data-aos="fade">

        <h2>@Breadcrumb.ServiceCategoriesTitle</h2>
        <ol>
            <li><a asp-area="@Breadcrumb.HomeArea" asp-controller="@Breadcrumb.HomeController" asp-action="Index">@Breadcrumb.HomeTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.AdminController" asp-action="Index">@Breadcrumb.AdminTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.AdminController" asp-action="Services">@Breadcrumb.ServicesDashboardTitle</a></li>
            <li>@Breadcrumb.ServiceCategoriesTitle</li>
        </ol>

    </div>
</div><!-- End Breadcrumbs -->

<section id="list" class="list">
    <div class="container" data-aos="fade-up">

        <div class="section-header">
            <h2>@Breadcrumb.ServiceCategoriesTitle</h2>
        </div>

        @if (Model.Any())
        {
            <div class="text-center">
                <div class="container" data-aos="fade-up">

                @foreach (var item in Model)
                {
                        <div class="row gy-4 list-item featured mt-4 justify-content-center" data-aos="fade-up" data-aos-delay="200">
                            @if (!string.IsNullOrWhiteSpace(item.ImageLink))
                            {
                                <div class="col-lg-4 d-flex align-items-center">
                                    <img class="img-square img-fluid" src="@item.ImageLink" />
                                </div>
                                <div class="col-lg-6 d-flex align-items-center justify-content-center">
                                    <div>
                                        <h3 class="mb-2">@item.Title</h3>
                                        <p>@Html.Raw(@item.Description)</p>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="col-lg-10 d-flex align-items-center justify-content-center">
                                    <div>
                                        <h3 class="mb-2">@item.Title</h3>
                                        <p>@Html.Raw(@item.Description)</p>
                                    </div>
                                </div>
                            }

                            <div class="flex-btn-container-row">
                                <a class="flex-btn-row edit-btn text-center" asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.ServiceCategoriesController"
                                   asp-action="@Breadcrumb.Edit" asp-route-id="@item.Id" class="readmore stretched-link">
                                    <span>@Breadcrumb.Edit</span><i class="fa-regular fa-pen-to-square"></i>
                                </a>
                                <a class="flex-btn-row delete-btn text-center" asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.ServiceCategoriesController"
                                   asp-action="@Breadcrumb.Delete" asp-route-id="@item.Id" class="readmore stretched-link">
                                    <span>@Breadcrumb.Delete</span><i class="fa-regular fa-trash-can"></i>
                                </a>
                                <br>
                            </div>

                        </div>
                }
                </div>

            </div>
        }

        <div class="col-12 add-btn-container text-center" data-aos="fade-up" data-aos-delay="100">
            <a class="add-button" asp-area="@Breadcrumb.AdminArea" asp-action="Create"><i class="bi bi-plus"></i></a>
        </div>
      
    </div>
</section>


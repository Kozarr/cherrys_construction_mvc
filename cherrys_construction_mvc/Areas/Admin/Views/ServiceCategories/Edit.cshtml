@model ServiceTypeRequest

@{
    ViewData["Title"] = Breadcrumb.ServiceCategoriesTitle;
}

<!-- ======= Breadcrumbs ======= -->
<div class="breadcrumbs d-flex align-items-center" style="background-image: url('/assets/img/breadcrumbs-bg.jpg');">
    <div class="container position-relative d-flex flex-column align-items-center" data-aos="fade">

        <h2>@Breadcrumb.ServiceCategoriesTitle</h2>
        <ol>
            <li><a asp-area="@Breadcrumb.HomeArea" asp-controller="@Breadcrumb.HomeController" asp-action="Index">@Breadcrumb.HomeTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.AdminController" asp-action="Index">@Breadcrumb.AdminTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.AdminController" asp-action="Services">@Breadcrumb.ServicesDashboardTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.ServiceCategoriesController" asp-action="Index">@Breadcrumb.ServiceCategoriesTitle</a></li>
            <li>@Breadcrumb.Edit</li>
        </ol>

    </div>
</div><!-- End Breadcrumbs -->

<section class="list">
    <div class="row">
        <div class="col-lg-6" style="margin-left: auto; margin-right:auto;">

            <!-- Multi Columns Form -->
            <form enctype="multipart/form-data" method="post" asp-action="Edit" asp-route-id="@Url.ActionContext.RouteData.Values["id"]">
                <div class="card">
                    <div class="card-body">
                        <div class="col-md-12">
                            <label asp-for="@Model.Title">Name</label>
                            <input asp-for="@Model.Title" class="form-control" />
                            <span asp-validation-for="@Model.Title" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="@Model.Description">Description</label>
                            <textarea asp-for="@Model.Description" class="form-control"></textarea>
                            <span asp-validation-for="@Model.Description" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="@Model.Image">Image</label>
                            <input asp-for="@Model.Image" type="file" class="form-control" />
                            <span asp-validation-for="@Model.Image" class="text-danger"></span>
                        </div>
                        <div class="mt-3">
                            <a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.ServiceCategoriesController" asp-action="Index" class="back-btn">@Breadcrumb.Back</a>
                            <button type="submit" class="edit-btn">@Breadcrumb.Save</button>
                        </div>

                    </div>
                </div>

            </form><!-- End Multi Columns Form -->

        </div>
    </div>
</section>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}

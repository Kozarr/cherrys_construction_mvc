@model IEnumerable<TagResponce>

@{
    ViewData["Title"] = Breadcrumb.TagsTitle;
}

<!-- ======= Breadcrumbs ======= -->
<div class="breadcrumbs d-flex align-items-center" style="background-image: url('/assets/img/breadcrumbs-bg.jpg');">
    <div class="container position-relative d-flex flex-column align-items-center" data-aos="fade">

        <h2>@Breadcrumb.TagsTitle</h2>
        <ol>
            <li><a asp-area="@Breadcrumb.HomeArea" asp-controller="@Breadcrumb.HomeController" asp-action="Index">@Breadcrumb.HomeTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.AdminController" asp-action="Index">@Breadcrumb.AdminTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.AdminController" asp-action="Projects">@Breadcrumb.ProjectsDashboardTitle</a></li>
            <li>@Breadcrumb.TagsTitle</li>
        </ol>

    </div>
</div><!-- End Breadcrumbs -->


<section id="list" class="list">
    <div class="container" data-aos="fade-up">

        <div class="section-header">
            <h2>@Breadcrumb.TagsTitle</h2>
        </div>

        @if (Model.Any())
        {
            <div class="text-center">
                <div class="container" data-aos="fade-up">

                    @foreach (var item in Model)
                    {
                        <div class="row gy-4 list-item featured mt-4" data-aos="fade-up" data-aos-delay="200">
                            <div class="col-lg-8 d-flex align-items-center justify-content-center">
                                <div class="col-lg-4">
                                    <h3>@item.Name</h3>
                                </div>
                            </div>
                            <div class="col-lg-3 d-flex justify-content-around align-items-center mb-3">
                                <div class="m-auto">
                                    <a class="edit-btn" asp-area="@Breadcrumb.AdminArea" asp-action="Edit" asp-route-id="@item.Id">@Breadcrumb.Edit</a>
                                </div>
                                <div class="m-auto">
                                    <a class="delete-btn" asp-area="@Breadcrumb.AdminArea" asp-action="Delete" asp-route-id="@item.Id">@Breadcrumb.Delete</a>
                                </div>
                            </div>
                        </div>
                    }

                </div>
                <div class="col-12 add-btn-container" data-aos="fade-up" data-aos-delay="100">
                    <a class="add-button" asp-area="@Breadcrumb.AdminArea" asp-action="Create"><i class="bi bi-plus"></i></a>
                </div>

            </div>
        }
        else
        {
            <div class="col-12 add-btn-container text-center" data-aos="fade-up" data-aos-delay="100">
                <a class="add-button" asp-area="@Breadcrumb.AdminArea" asp-action="Create"><i class="bi bi-plus"></i></a>
            </div>
        }
    </div>
</section>
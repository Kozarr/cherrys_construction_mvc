@model TagRequest

@{
    ViewData["Title"] = Breadcrumb.TagsTitle;
}

<!-- ======= Breadcrumbs ======= -->
<div class="breadcrumbs d-flex align-items-center" style="background-image: url('/assets/img/breadcrumbs-bg.jpg');">
    <div class="container position-relative d-flex flex-column align-items-center" data-aos="fade">

        <h2>@Breadcrumb.TagsTitle</h2>
        <ol>
            <li><a asp-area="@Breadcrumb.HomeArea" asp-controller="@Breadcrumb.HomeController" asp-action="Index">@Breadcrumb.HomeTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.AdminController" asp-action="Index">@Breadcrumb.AdminTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.AdminController" asp-action="Projects">@Breadcrumb.ProjectsDashboardTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.TagsController" asp-action="Index">@Breadcrumb.TagsTitle</a></li>
            <li>@Breadcrumb.Create</li>
        </ol>

    </div>
</div><!-- End Breadcrumbs -->

<section id="list" class="list">
    <div class="row">
        <div class="col-lg-6" style="margin-left: auto; margin-right:auto;">

            <form enctype="multipart/form-data" method="post" asp-action="Create">
                <div class="card">
                    <div class="card-body">
                        <div class="col-md-12">  
                            <div class="form-floating">
                            <input asp-for="Name" id="obj123" class="form-control" placeholder="Tag Filter Name" />
                            <label asp-for="Name" for="obj123">Tag Filters For Projects</label>
                            <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="mt-3">
                            <a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.TagsController" asp-action="Index" class="back-btn">@Breadcrumb.Back</a>
                            <button type="submit" class="create-btn">@Breadcrumb.Create</button>
                        </div>
                    </div>
                </div>
            </form>

        </div>
    </div>
</section>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}

@model HeroSliderRequest

@{
    ViewData["Title"] = Breadcrumb.HeroTitle;
}

<!-- ======= Breadcrumbs ======= -->
<div class="breadcrumbs d-flex align-items-center" style="background-image: url('/assets/img/breadcrumbs-bg.jpg');">
    <div class="container position-relative d-flex flex-column align-items-center" data-aos="fade">

        <h2>@Breadcrumb.HeroTitle</h2>
        <ol>
            <li><a asp-area="@Breadcrumb.HomeArea" asp-controller="@Breadcrumb.HomeController" asp-action="Index">@Breadcrumb.HomeTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.AdminController" asp-action="Index">@Breadcrumb.AdminTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.HeroController" asp-action="Index">@Breadcrumb.HeroTitle</a></li>
            <li>@Breadcrumb.Edit</li>
        </ol>

    </div>
</div><!-- End Breadcrumbs -->


<section id="list" class="list">
    <div class="row">
        <div class="list-container">

            <!-- Multi Columns Form -->
            <form enctype="multipart/form-data" method="post" asp-action="Edit">
                <div class="card">
                    <div class="card-body">
                        <div class="col-md-12 form-floating mb-3">
                            <input asp-for="Title" id="obj1" class="form-control" placeholder="Hero Title" />
                            <label asp-for="Title" for="obj1">Hero Title</label>
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                        <div class="col-md-12 form-floating mb-3">
                            <input asp-for="ButtonText" id="obj2" class="form-control" placeholder="Hero Button Text" />
                            <label asp-for="ButtonText" for="obj2">Scroll Down To Services Button</label>
                            <span asp-validation-for="ButtonText" class="text-danger"></span>
                        </div>
                        <div class="col-md-12 mb-5">
                            <textarea asp-for="Description" class="form-control" placeholder="Description..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                        <div class="col-12 mb-3">
                            <input asp-for="ListImages" type="file" multiple class="form-control" />
                            <span asp-validation-for="ListImages" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            @if (Model.ActiveImages != null)
                            {
                                @if (Model.ActiveImages.Any())
                                {
                                    <div class="row">
                                        @foreach (var image in Model.ActiveImages)
                                        {
                                            string newId = "btn-check-outlined" + @image.Id;
                                            <div class="col-lg-2 col-md-3 col-sm-5 mb-3">
                                                <div class="mb-2">
                                                    <img class="img-fluid" src="@image.PathImage">
                                                </div>
                                                <input name="checkPhoto" id="@newId" type="checkbox" class="btn-check" value="@image.Id" autocomplete="off">
                                                <label class="btn btn-outline-danger" for="@newId">Delete This</label><br>          
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>

                        <a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.HeroController" asp-action="Index" class="back-btn">@Breadcrumb.Back</a>
                        <button type="submit" class="edit-btn">@Breadcrumb.Save</button>

                    </div>
                </div>

            </form><!-- End Multi Columns Form -->

        </div>
    </div>
</section>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}


@model HeroSliderResponce

@{
    ViewData["Title"] = Breadcrumb.HeroTitle;
}

<!-- ======= Breadcrumbs ======= -->
<div class="breadcrumbs d-flex align-items-center" style="background-image: url('/assets/img/breadcrumbs-bg.jpg');">
    <div class="container position-relative d-flex flex-column align-items-center" data-aos="fade">

        <h2>@Breadcrumb.HeroTitle</h2>
        <ol>
            <li><a asp-area="@Breadcrumb.HomeArea" asp-controller="@Breadcrumb.HomeController" asp-action="Index">@Breadcrumb.HomeTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.AdminController" asp-action="Index">@Breadcrumb.AdminTitle</a></li>
            <li>@Breadcrumb.HeroTitle</li>
        </ol>

    </div>
</div><!-- End Breadcrumbs -->

<section id="list" class="list">
    <div class="container" data-aos="fade-up">

        <div class="section-header">
            <h2>@Breadcrumb.HeroTitle</h2>
        </div>


        @if (Model != null)
        {
            <div class="text-center pt-5 pb-5">
                <div class="container" data-aos="fade-up">

                    <div class="row gy-4 list-item featured mt-4" data-aos="fade-up" data-aos-delay="200">
                        <div class="col-md-12 d-flex align-items-center justify-content-center">

                            <h3>@Model.Title</h3>
                            <p>@Html.Raw(Model.Description)</p>

                        </div>
                        <div class="flex-btn-container-row">
                            <a class="flex-btn-row edit-btn text-center" asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.HeroController"
                               asp-action="@Breadcrumb.Edit" asp-route-id="@Model.Id" class="readmore stretched-link">
                                <span>@Breadcrumb.Edit</span><i class="fa-regular fa-pen-to-square"></i>
                            </a>
                            <br>
                        </div>
                    </div>


                </div>
            </div>
        }
        else
        {
            <div class="container pt-3 pb-2">
                <div class="col-12 add-btn-container text-center" data-aos="fade-up" data-aos-delay="100">
                    <a class="add-button" asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.HeroController" asp-action="Create"><i class="bi bi-plus"></i></a>
                </div>
            </div>
        }
    </div>
</section>


@model IEnumerable<MemberResponce>

@{
    ViewData["Title"] = Breadcrumb.MembersTitle;
}

<!-- ======= Breadcrumbs ======= -->
<div class="breadcrumbs d-flex align-items-center" style="background-image: url('/assets/img/breadcrumbs-bg.jpg');">
    <div class="container position-relative d-flex flex-column align-items-center" data-aos="fade">

        <h2>@Breadcrumb.MembersTitle</h2>
        <ol>
            <li><a asp-area="@Breadcrumb.HomeArea" asp-controller="@Breadcrumb.HomeController" asp-action="Index">@Breadcrumb.HomeTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.AdminController" asp-action="Index">@Breadcrumb.AdminTitle</a></li>
            <li>@Breadcrumb.MembersTitle</li>
        </ol>
    </div>
</div><!-- End Breadcrumbs -->

<section id="members" class="members">
    <div class="container" data-aos="fade-up">

        <div class="section-header">
            <h2>@Breadcrumb.MembersTitle</h2>
        </div>

        @if (Model.Any())
        {
            <div class="text-center">
                <div class="container" data-aos="fade-up">

                @foreach (var member in Model)
                {
                        <div class="row gy-4 member-item featured mt-4" data-aos="fade-up" data-aos-delay="200">
                            <div class="col-lg-3 col-md-4 d-flex align-items-center justify-content-center">
                                <div>
                                    <h3>@member.Name</h3>
                                    <h5>@member.Role</h5>
                                    <img src="@member.ImageLink" class="img-fluid" />
                                </div>                                       
                            </div>
                            <div class="col-lg-9 col-md-8 d-flex align-items-center justify-content-center">
                                <p>@Html.Raw(@member.Description)</p>
                            </div>
                            @* <div class="col-lg-3 d-flex align-content-center justify-content-center mb-4">
                                
                            </div> *@

                            <div class="flex-btn-container-row">
                                <a class="flex-btn-row edit-btn text-center" asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.MembersController"
                                   asp-action="@Breadcrumb.Edit" asp-route-id="@member.Id" class="readmore stretched-link">
                                    <span>@Breadcrumb.Edit</span><i class="fa-regular fa-pen-to-square"></i>
                                </a>
                                <a class="flex-btn-row delete-btn text-center" asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.MembersController"
                                   asp-action="@Breadcrumb.Delete" asp-route-id="@member.Id" class="readmore stretched-link">
                                    <span>@Breadcrumb.Delete</span><i class="fa-regular fa-trash-can"></i>
                                </a>
                                <br>
                            </div>

                        </div><!-- End Members Item -->
                }
                </div>

            </div>
        }

        <div class="col-12 add-btn-container text-center" data-aos="fade-up" data-aos-delay="100">
            <a class="add-button" asp-area="@Breadcrumb.AdminArea" asp-action="Create"><i class="bi bi-plus"></i></a>
        </div>
        

    </div>
</section>

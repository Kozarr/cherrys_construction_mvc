@model MemberRequest

@{
    ViewData["Title"] = Breadcrumb.MembersTitle;
}

<!-- ======= Breadcrumbs ======= -->
<div class="breadcrumbs d-flex align-items-center" style="background-image: url('/assets/img/breadcrumbs-bg.jpg');">
    <div class="container position-relative d-flex flex-column align-items-center" data-aos="fade">

        <h2>@Breadcrumb.MembersTitle</h2>
        <ol>
            <li><a asp-area="@Breadcrumb.HomeArea" asp-controller="@Breadcrumb.HomeController" asp-action="Index">@Breadcrumb.HomeTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.AdminController" asp-action="Index">@Breadcrumb.AdminTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.MembersController" asp-action="Index">@Breadcrumb.MembersTitle</a></li>
            <li>@Breadcrumb.Create</li>
        </ol>

    </div>
</div><!-- End Breadcrumbs -->

<section class="members">
    <div class="row">
        <div class="col-lg-6" style="margin-left: auto; margin-right:auto;">


            <!-- Multi Columns Form -->
            <form enctype="multipart/form-data" method="post">
                <div class="card">
                    <div class="card-body">
                        <div class="row">


                            <div class="col-lg-6 col-md-8">
                                <div class="form-floating mb-3">
                                    <input type="text" class="form-control" id="fullName" placeholder="Full Name" asp-for="Name">
                                    <label for="fullName" asp-for="Name">Full Name</label>
                                    <span asp-validation-for="Name" class="text-danger" for="floatingInput"></span>
                                </div>
                            </div>
                            <div class="col-lg-6 col-md-4">
                                <div class="form-floating mb-3">
                                    <input asp-for="Role" id="role" class="form-control" placeholder="Role" />
                                    <label asp-for="Role" for="role">Role</label>
                                    <span asp-validation-for="Role" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-lg-12">
                                <div class="form-floating mb-3">
                                    <input asp-for="InstagramLink" id="instaLink" class="form-control" placeholder="Instagram" />
                                    <label asp-for="InstagramLink" for="instaLink">Instagram Link</label>
                                </div>
                            </div>
                            
                            <div class="col-12">
                                <label asp-for="Description">Description</label>
                                <textarea asp-for="Description" class="form-control"></textarea>
                            </div>
                            <div class="col-12 mb-3 mt-3">
                                <label asp-for="Image" class="text-danger">Please Make Photograph Is Square! (1:1 Ratio)</label>
                                <input asp-for="Image" type="file" class="form-control" />
                                <span asp-validation-for="Image" class="text-danger"></span>
                            </div>
                            <div class="mt-3">
                                <a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.MembersController" asp-action="Index" class="back-btn">@Breadcrumb.Back</a>
                                <button type="submit" class="create-btn">@Breadcrumb.Create</button>
                            </div>
                        </div>
                    </div>
                </div>

            </form><!-- End Multi Columns Form -->

        </div>
    </div>
</section>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}

@model CompanyStoryRequest

@{
    ViewData["Title"] = Breadcrumb.StoryTitle;
}

<!-- ======= Breadcrumbs ======= -->
<div class="breadcrumbs d-flex align-items-center" style="background-image: url('assets/img/breadcrumbs-bg.jpg');">
    <div class="container position-relative d-flex flex-column align-items-center" data-aos="fade">

        <h2>@Breadcrumb.StoryTitle</h2>
        <ol>
            <li><a asp-area="@Breadcrumb.HomeArea" asp-controller="@Breadcrumb.HomeController" asp-action="Index">@Breadcrumb.HomeTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.AdminController" asp-action="Index">@Breadcrumb.AdminTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.StoryController" asp-action="Index">@Breadcrumb.StoryTitle</a></li>
            <li>@Breadcrumb.Create</li>
        </ol>

    </div>
</div><!-- End Breadcrumbs -->

<section id="list" class="list">
    <div class="row">
        <div class="col-lg-6" style="margin-left: auto; margin-right:auto;">


            <!-- Multi Columns Form -->
            <form enctype="multipart/form-data" method="post" asp-action="Create">
                <div class="card">
                    <div class="card-body row">
                        <div class="col-md-6">
                            <div class="form-floating mb-3">
                                <input id="obj45" asp-for="@Model.Title" class="form-control" placeholder="Section Title" />
                                <label for="obj45" asp-for="@Model.Title">Section Title</label>
                                <span asp-validation-for="@Model.Title" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating mb-3">
                                <input id="obj45" asp-for="@Model.ArticleTitle" class="form-control" placeholder="Title of Our Story" />
                                <label for="obj45" asp-for="@Model.ArticleTitle">Title of "Our Story" Article</label>
                                <span asp-validation-for="@Model.ArticleTitle" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="form-floating mb-3">
                                <input id="obj45" asp-for="@Model.ArticleSmallText" class="form-control" placeholder="Small-Text" />
                                <label for="obj45" asp-for="@Model.ArticleSmallText">Our Story Small-Text (ex. Established 1952)</label>
                                <span asp-validation-for="@Model.ArticleSmallText" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-12 mb-3">
                            <textarea asp-for="@Model.ArticleDescription" class="form-control" placeholder="Out Story..."></textarea>
                            <span asp-validation-for="@Model.ArticleDescription" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <input asp-for="Image" type="file" class="form-control" />
                            <span asp-validation-for="Image" class="text-danger"></span>
                        </div>
                        <div class="mt-3">
                            <a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.StoryController" asp-action="Index" class="back-btn">@Breadcrumb.Back</a>
                            <button type="submit" class="create-btn">@Breadcrumb.Create</button>
                        </div>

                    </div>
                </div>

            </form><!-- End Multi Columns Form -->

        </div>
    </div>
</section>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}
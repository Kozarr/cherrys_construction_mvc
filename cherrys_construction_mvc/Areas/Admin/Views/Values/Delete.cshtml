@model CompanyValueResponce

@{
    ViewData["Title"] = Breadcrumb.ValuesTitle;
}

<!-- ======= Breadcrumbs ======= -->
<div class="breadcrumbs d-flex align-items-center" style="background-image: url('assets/img/breadcrumbs-bg.jpg');">
    <div class="container position-relative d-flex flex-column align-items-center" data-aos="fade">

        <h2>@Breadcrumb.ValuesTitle</h2>
        <ol>
            <li><a asp-area="@Breadcrumb.HomeArea" asp-controller="@Breadcrumb.HomeController" asp-action="Index">@Breadcrumb.HomeTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.AdminController" asp-action="Index">@Breadcrumb.AdminTitle</a></li>
            <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.ValuesController" asp-action="Index">@Breadcrumb.ValuesTitle</a></li>
            <li>@Breadcrumb.Delete</li>
        </ol>

    </div>
</div><!-- End Breadcrumbs -->

<section id="list" class="list">
    <div class="row">
        <div class="col-lg-6" style="margin-left: auto; margin-right:auto;">

            <form enctype="multipart/form-data" method="post" asp-action="Delete">
                <div class="card">
                    <div class="card-body">
                        @if (Model.ImageLink != null)
                        {
                            <div class="text-center mb-3">
                                <img src="@Model.ImageLink" class="img-fluid" style="clip-path:none;max-width: 400px;" />
                            </div>
                        }
                        <div class="col-md-12">
                            <div class="form-floating mb-3">
                                <input id="obj34" asp-for="Title" class="form-control" placeholder="Name or Title of Value" disabled />
                                <label for="obj34" asp-for="Title">Name or Title of Value</label>
                            </div>
                        </div>
                        <div class="col-md-12 mb-3">
                            <textarea id="readonly" asp-for="Description" class="form-control" placeholder="Value Description"></textarea>
                        </div>
                        <div class="mt-3">
                            <a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.ValuesController" asp-action="Index" class="back-btn">@Breadcrumb.Back</a>
                            <button type="submit" class="delete-btn">@Breadcrumb.Delete</button>
                        </div>
                    </div>
                </div>

            </form>

        </div>
    </div>
</section>
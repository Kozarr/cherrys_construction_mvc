@using cherrys_construction_mvc.ViewModels.Blog;
@model BlogDetailsViewModel

@{
    ViewData["Title"] = Breadcrumb.UserBlogTitle;
    if (Model.Post != null)
    {
        ViewData["Title"] = Model.Post.Title;
    }
}

<!-- ======= Breadcrumbs ======= -->
@if (Model.CompanyInfo != null && Model.CompanyInfo.NavigationImageURL != null)
{
    string imageLink = Model.CompanyInfo.NavigationImageURL.Remove(0, 8);
    string image = ("~/images/" + imageLink);
    <div class="breadcrumbs d-flex align-items-center" style="background-image: url('@Url.Content(image)');">
        <div class="container position-relative d-flex flex-column align-items-center" data-aos="fade">

            <h2>@Breadcrumb.UserBlogTitle</h2>
            <ol>
                <li><a asp-area="@Breadcrumb.HomeArea" asp-controller="@Breadcrumb.HomeController" asp-action="Index">@Breadcrumb.HomeTitle</a></li>
                <li><a asp-area="@Breadcrumb.HomeArea" asp-controller="@Breadcrumb.UserBlogController" asp-action="Index">@Breadcrumb.UserBlogTitle</a></li>
                <li>@ViewData["Title"]</li>
            </ol>

        </div>
    </div>
}
else
{
    <div class="breadcrumbs d-flex align-items-center" style="background-color: darkslategray;">
        <div class="container position-relative d-flex flex-column align-items-center" data-aos="fade">

            <h2>@Breadcrumb.UserBlogTitle</h2>
            <ol>
                <li><a asp-area="@Breadcrumb.HomeArea" asp-controller="@Breadcrumb.HomeController" asp-action="Index">@Breadcrumb.HomeTitle</a></li>
                <li><a asp-area="@Breadcrumb.HomeArea" asp-controller="@Breadcrumb.UserBlogController" asp-action="Index">@Breadcrumb.UserBlogTitle</a></li>
                <li>@ViewData["Title"]</li>
            </ol>

        </div>
    </div>
}
    
<!-- ======= Blog Details Section ======= -->
<section id="blog" class="blog">
    <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row g-5">

            <div class="col-lg-8">

                <article class="blog-details">

                    <div class="post-img text-center">
                        @if(!string.IsNullOrWhiteSpace(Model.Post.ImageLink)){
                            <img src="@Model.Post.ImageLink" alt="Blog Post Image" class="img-fluid">
                        }                      
                    </div>
                        @if(!string.IsNullOrWhiteSpace(Model.Post.Title)){
                            <h2 class="title">@Model.Post.Title</h2>
                        }              
                    <div class="meta-top">
                        <ul>
                            @if(Model.CompanyInfo != null)
                            {
                                @if (!string.IsNullOrWhiteSpace(Model.CompanyInfo.CompanyName))
                                {
                                    <li class="d-flex align-items-center"><i class="bi bi-person"></i>@Model.CompanyInfo.CompanyName</li>
                                }
                            }
                            <li class="d-flex align-items-center"><i class="bi bi-clock"></i>Published: @Model.Post.CreatedDateString</li>
                            @if (!string.IsNullOrWhiteSpace(Model.Post.UpdatedDateString))
                            {
                                <li class="d-flex align-items-center"><i class="bi bi-arrow-repeat"></i>Updated: @Model.Post.UpdatedDateString</li>
                            }

                        </ul>
                    </div><!-- End meta top -->

                    <div class="content">                     
                        @Html.Raw(Model.Post.Description)    
                    </div><!-- End post content -->

                    <div class="meta-bottom">
                        <i class="bi bi-folder"></i>
                        <ul class="cats">
                            <li><a href="#">Business</a></li>
                        </ul>

                        <i class="bi bi-tags"></i>
                        <ul class="tags">
                            <li><a href="#">Creative</a></li>
                            <li><a href="#">Tips</a></li>
                            <li><a href="#">Marketing</a></li>
                        </ul>
                    </div><!-- End meta bottom -->

                </article><!-- End blog post -->
                @if(Model.CompanyInfo != null)
                {
                    <div class="post-author d-flex align-items-center">
                        <img src="/assets//img//brand/cherrys-logo-black.png" class="flex-shrink-0" alt="">
                        <div>
                            @if(!string.IsNullOrWhiteSpace(Model.CompanyInfo.CompanyName)){
                                <h3>@Model.CompanyInfo.CompanyName</h3>
                            }
                            
                            <div class="social-links">
                                
                                @if (!string.IsNullOrWhiteSpace(Model.CompanyInfo.FaceBookLink))
                                {
                                    <a href="@Model.CompanyInfo.FaceBookLink"><i class="fa-brands fa-facebook"></i></a>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.CompanyInfo.InstagramLink))
                                {
                                    <a href="@Model.CompanyInfo.InstagramLink"><i class="fa-brands fa-instagram"></i></a>
                                }                               
                                @if (!string.IsNullOrWhiteSpace(Model.CompanyInfo.YoutubeLink))
                                {
                                    <a href="@Model.CompanyInfo.YoutubeLink"><i class="fa-brands fa-youtube"></i></a>
                                }                              
                                @if (!string.IsNullOrWhiteSpace(Model.CompanyInfo.LinkedInLink))
                                {
                                    <a href="@Model.CompanyInfo.LinkedInLink"><i class="fa-brands fa-linkedin"></i></a>
                                }                           
                                @if (!string.IsNullOrWhiteSpace(Model.CompanyInfo.TwitterLink))
                                {                                 
                                    <a href="@Model.CompanyInfo.TwitterLink"><i class="fa-brands fa-twitter"></i></a>                                  
                                }
                                                
                            </div>
                        </div>
                    </div>

                    <!-- End post author -->
                }
                
            </div>
            @if (Model.BlogList.Any())
                            {
            <div class="col-lg-4">

                <div class="sidebar">

                    <div class="sidebar-item recent-posts">
                        <h3 class="sidebar-title">Recent Posts</h3>

                        <div class="mt-3">
                            
                            @foreach (var post in Model.BlogList)
                            {
                                    <div class="post-item">
                                        @if (post.ImageLink != null)
                                        {
                                            <div class="blog-img-container">                                          
                                                <img src="@post.ImageLink" alt="Blog Post Image">                                           
                                            </div>
                                        }
                                        
                                        <div>
                                            <h4><a asp-area="@Breadcrumb.HomeArea" asp-controller="@Breadcrumb.UserBlogController"
                                            asp-action="Details" asp-route-id="@post.Id">@post.Title</a></h4>
                                            <time datetime="2020-01-01">@post.CreatedDateString</time>
                                        </div>
                                    </div>

                                    <!-- End recent post item-->
                            }


                        </div>

                    </div><!-- End sidebar recent posts-->

                </div><!-- End Blog Sidebar -->

            </div>
            }
        </div>

    </div>
</section><!-- End Blog Details Section -->
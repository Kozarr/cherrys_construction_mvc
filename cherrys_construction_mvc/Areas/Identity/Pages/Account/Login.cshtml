@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<section id="login" class="section register min-vh-100 d-flex flex-column align-items-center justify-content-center py-4">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-4 col-md-6 d-flex flex-column align-items-center justify-content-center">

                <div class="col-12 justify-content-center py-4 text-center">
                    <a asp-area="User" asp-asp-controller="Home" asp-action="Index" class="logo align-items-center col-12">
                        <!-- <img class="w-25" src="/assets/img/brand/cherrys-logo-white.png" alt="Logo"> -->
                        <!--@*<span class="d-none d-lg-block">Cherry's Construction</span>*@-->
                    </a>
                </div><!-- End Logo -->

                <div class="card mb-3">
                    <div class="card-body">
                        <div class="pt-4 pb-2">
                            <h5 class="card-title text-center pb-0 fs-4">Login to Your Account</h5>
                            <p class="text-center small">Enter your username & password to login</p>
                        </div>
                        <form id="account" method="post" class="row g-3 needs-validation">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            <div class="col-12">
                                <div class="form-floating">
                                    <input id="loginEmailObj0" asp-for="Input.Email" class="form-control" autocomplete="email" aria-required="true" placeholder="Email" />
                                    <label for="loginEmailObj0" asp-for="Input.Email" class="form-label">Email</label>
                                    <span asp-validation-for="Input.Email" class="text-danger invalid-feedback"></span>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating">
                                    <input id="loginPassObj0" asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Password" />
                                    <label for="loginPassObj0" asp-for="Input.Password" class="form-label invalid-feedback">Password</label>
                                    <span asp-validation-for="Input.Password" class="text-danger invalid-feedback"></span>
                                </div>
                            </div>
                            <div class="col-12 check-container">
                                <div class="form-check">
                                    <div class="checkbox">
                                        <label asp-for="Input.RememberMe" class="form-check-label">
                                            <input class="form-check-input" asp-for="Input.RememberMe" />
                                            <div class="login-form-label">@Html.DisplayNameFor(m => m.Input.RememberMe)</div>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="col-12">
                                <button id="login-submit" type="submit" class="btn btn-primary w-100">Login</button>
                            </div>

                            <div class="col-12 form-links">
                                <p class="small mb-0">
                                    <a id="forgot-password" asp-page="./ForgotPassword" style="color:grey;">Forgot your password?</a>
                                </p>
                                <p class="small mb-0">
                                    <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" style="color:grey;">Resend email confirmation</a>
                                </p>
                            </div>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

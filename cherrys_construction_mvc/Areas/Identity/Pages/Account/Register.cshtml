@page
@using cherrys_construction_mvc.Utility;
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<!-- ======= Breadcrumbs ======= -->
<div class="breadcrumbs d-flex align-items-center" style="background-image: url('/assets/img/breadcrumbs-bg.jpg');">
    <div class="container position-relative d-flex flex-column align-items-center" data-aos="fade">

        @if (User.IsInRole(StaticDetails.Role_Admin))
        {
            <h2 class="pt-4">@ViewData["Title"] - Admin Portal</h2>
        }
        else
        {
            <h2 class="pt-4">@ViewData["Title"]</h2>
        }
        <ol>

            <li>Account</li>
        </ol>

    </div>
</div><!-- End Breadcrumbs -->

<div class="container account-form">
    <div class="row pt-4">
        <div class="col-md-7">
            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="row">
                <h2>@ViewData["Title"] a user.</h2>
                <hr />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="col-12">
                    <div class="form-floating py-2">
                        <input asp-for="Input.Email" class="form-control" autocomplete="on" placeholder="Email" aria-required="true" />
                        <label asp-for="Input.Email"></label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-floating py-2">
                        <input asp-for="Input.Name" class="form-control" autocomplete="on" placeholder="Name" aria-required="true" />
                        <label asp-for="Input.Name"></label>
                        <span asp-validation-for="Input.Name" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-floating py-2">
                        <input asp-for="Input.PhoneNumber" class="form-control" autocomplete="on" placeholder="Phone number" aria-required="true" />
                        <label asp-for="Input.PhoneNumber"></label>
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-floating py-2">
                        <input asp-for="Input.StreetAddress" class="form-control" autocomplete="on" placeholder="Street address" aria-required="true" />
                        <label asp-for="Input.StreetAddress"></label>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-floating py-2">
                        <input asp-for="Input.City" class="form-control" autocomplete="on" placeholder="City" aria-required="true" />
                        <label asp-for="Input.City"></label>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-floating py-2">
                        <input asp-for="Input.State" class="form-control" autocomplete="on" placeholder="State" aria-required="true" />
                        <label asp-for="Input.State"></label>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-floating py-2">
                        <input asp-for="Input.PostalCode" class="form-control" autocomplete="on" placeholder="Postal code" aria-required="true" />
                        <label asp-for="Input.PostalCode"></label>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-floating py-2">
                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" placeholder="Password" aria-required="true" />
                        <label asp-for="Input.Password"></label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-6">
                    <div class="form-floating py-2">
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Confirm password" aria-required="true" />
                        <label asp-for="Input.ConfirmPassword"></label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>
                
                @if (User.IsInRole(StaticDetails.Role_Admin))
                {
                    <div class="form-floating py-2 col-6">
                        <select asp-for="Input.Role" asp-items="@Model.Input.RoleList" class="form-select">
                            <option disabled selected>-Select Role-</option>
                        </select>
                    </div>
                }
                <button id="registerSubmit" type="submit" class="w-100 edit-btn mt-3">Register</button>
            </form>
        </div>
        @if (!User.IsInRole(StaticDetails.Role_Admin))
        {
            <div class="col-md-5">
                <section>
                    <h3>Use another service to register.</h3>
                    <hr />
                    @{
                        if ((Model.ExternalLogins?.Count ?? 0) == 0)
                        {
                            <div>
                                <p>
                                    There are no external authentication services configured. See this <a href="https://go.microsoft.com/fwlink/?LinkID=532715">
                                        article
                                        about setting up this ASP.NET application to support logging in via external services
                                    </a>.
                                </p>
                            </div>
                        }
                        else
                        {
                            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
                                <div>
                                    <p>
                                        @foreach (var provider in Model.ExternalLogins)
                                        {
                                            <button type="submit" class="btn btn-primary" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">@provider.DisplayName</button>
                                        }
                                    </p>
                                </div>
                            </form>
                        }
                    }
                </section>
            </div>
        }
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
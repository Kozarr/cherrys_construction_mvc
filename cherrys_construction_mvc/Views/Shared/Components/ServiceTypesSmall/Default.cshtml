@model List<ServiceTypeResponce>
@if (Model != null)
{
    @if (Model.Any())
    {
        <!-- ======= Service Cards Section ======= -->
        var DataAOS = 100;
        <section id="services-cards" class="services-cards section">
            <div class="container" data-aos="fade-up">
                <div class="row gy-4">

                    @foreach (var item in Model)
                    {
                        <div class="col-lg-3 col-md-6" data-aos="zoom-in" data-aos-delay="@DataAOS">
                            <h3>@item.Title</h3>
                            <p>@Html.Raw(item.Description)</p>
                        </div>
                        DataAOS += 100;
                    }
                </div>
            </div>
        </section>
        <!-- End Service Cards Section -->
    }
}
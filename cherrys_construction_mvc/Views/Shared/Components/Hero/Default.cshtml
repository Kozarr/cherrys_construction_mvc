@model HeroSliderResponce
@if (Model != null)
{
    @if (!string.IsNullOrWhiteSpace(Model.Title))
    {
        <!-- ======= Hero Section ======= -->
        <section id="hero" class="hero">
            @if (Model == null)
            {
                <div class="vh-100" style="background-color: slategrey;">
                    <p class="text-center vh-100" style="transform: translate(0%,50%);font-size:20px;">Please add a Hero</p>
                </div>
            }
            else
            {
                int slideItem = 1;
                <div class="info d-flex align-items-center">
                    <div class="container">
                        <div class="row justify-content-center">
                            <div class="col-lg-6 text-center">
                                @if (Model.Title != null)
                                {
                                    <h2 data-aos="fade-down">@Model.Title</h2>
                                }
                                <div data-aos="fade-up" data-aos-delay="200">@Html.Raw(Model.Description)</div>
                                <a data-aos="fade-up" data-aos-delay="200" href="#constructions" class="btn-get-started">@Model.ButtonText</a>
                                <a data-aos="fade-up" data-aos-delay="200" class="btn-get-started" asp-area="User" asp-controller="Contact" asp-action="Index">Contact us</a>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="hero-carousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="6000">
                    @if (Model.Images != null)
                    {
                        @if (Model.Images.Any())
                        {
                            @foreach (var image in Model.Images)
                            {
                                if (!string.IsNullOrWhiteSpace(image.PathImage))
                                {
                                    string imageLink = image.PathImage.Remove(0, 8);
                                    string newLink = ("~/images/" + imageLink);
                                    @if (slideItem == 1)
                                    {
                                        <div class="carousel-item active" style="background-image: url('@Url.Content(newLink)')"></div>
                                    }
                                    else
                                    {
                                        <div class="carousel-item" style="background-image: url('@Url.Content(newLink)')"></div>
                                    }
                                    slideItem += 1;
                                }
                            }
                        }
                    }
                    else
                    {
                        <div class="carousel-item active" style="background-color: grey;"></div>
                    }
                    <a class="carousel-control-prev" href="#hero-carousel" role="button" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon bi bi-chevron-left" aria-hidden="true"></span>
                    </a>

                    <a class="carousel-control-next" href="#hero-carousel" role="button" data-bs-slide="next">
                        <span class="carousel-control-next-icon bi bi-chevron-right" aria-hidden="true"></span>
                    </a>

                </div>
            }
        </section>
        <!-- End Hero Section -->
    }
}
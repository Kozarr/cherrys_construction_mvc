@using cherrys_construction_mvc.Utility;
@using Microsoft.AspNetCore.Identity

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cherry's Construction</title>

    <!-- Favicons -->
    <link href="/assets/img/brand/cherrys-icon.png" rel="icon">
    <link href="/assets/img/brand/cherrys-icon.png" rel="apple-touch-icon">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,600;1,700&family=Roboto:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=Work+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet">

    <!-- Vendor CSS Files -->
    <link href="~/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/assets/vendor/fontawesome-free/css/all.min.css" rel="stylesheet">
    <link href="~/assets/vendor/aos/aos.css" rel="stylesheet">
    <link href="~/assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">
    <link href="~/assets/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">

    <!-- FontAwesome -->
@*    <script src="https://kit.fontawesome.com/8a1d5615a6.js" crossorigin="anonymous"></script>*@

    <!-- TinyMCE -->
    <script src="~/lib/tinymce/tinymce.min.js" referrerpolicy="origin"></script>

    <!-- Main CSS File -->
    <link href="~/assets/scss/main.css" rel="stylesheet">

</head>
<body>

    <header id="header" class="header d-flex align-items-center fixed-top">

        <div class="container-fluid container-xl d-flex align-items-center justify-content-between">

            <a asp-area="User" asp-controller="Home" asp-action="Index" class="logo d-flex align-items-center">
                <img src="~/assets/img/brand/cherrys-logo-white.png" alt="Logo">
            </a>

            <i class="mobile-nav-toggle mobile-nav-show bi bi-list"></i>
            <i class="mobile-nav-toggle mobile-nav-hide d-none bi bi-x"></i>
            <nav id="navbar" class="navbar">
                <ul>
                    <li><a asp-area="@Breadcrumb.HomeArea" asp-controller="@Breadcrumb.HomeController" asp-action="Index">@Breadcrumb.Home</a></li>
                    <li><a asp-area="@Breadcrumb.HomeArea" asp-controller="@Breadcrumb.UserAboutController" asp-action="Index">@Breadcrumb.UserAboutTitle</a></li>
                    <li><a asp-area="@Breadcrumb.HomeArea" asp-controller="@Breadcrumb.UserServicesController" asp-action="Index">@Breadcrumb.UserServicesTitle</a></li>
                    <li><a asp-area="@Breadcrumb.HomeArea" asp-controller="@Breadcrumb.UserProjectsController" asp-action="Index">@Breadcrumb.UserProjectsTitle</a></li>
                    <li><a asp-area="@Breadcrumb.HomeArea" asp-controller="@Breadcrumb.UserContactController" asp-action="Index">@Breadcrumb.UserContactTitle</a></li>
                    @if (User.IsInRole(StaticDetails.Role_Admin))
                    {
                        <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.AdminController" asp-action="Index">@Breadcrumb.Admin</a></li>
                    }
                    @if (User.IsInRole(StaticDetails.Role_Employee))
                    {
                        <li><a asp-area="@Breadcrumb.AdminArea" asp-controller="@Breadcrumb.AdminController" asp-action="Index">@Breadcrumb.Admin</a></li>
                    }

                    <partial name="_LoginPartial" />
                </ul>
            </nav><!-- .navbar -->
        </div>

    </header>

    <main role="main">
        <partial name="_TempDataNotification" />
        @RenderBody()
    </main>

    @await Component.InvokeAsync("Footer")

    <a href="#" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

    <div id="preloader"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!-- Vendor JS Files -->
    <script src="~/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/vendor/aos/aos.js"></script>
    <script src="~/assets/vendor/glightbox/js/glightbox.min.js"></script>
    <script src="~/assets/vendor/isotope-layout/isotope.pkgd.min.js"></script>
    <script src="~/assets/vendor/swiper/swiper-bundle.min.js"></script>
    <script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>


    <!-- Could Get Rid of this below-->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.3/jquery.min.js" integrity="sha512-STof4xm1wgkfm7heWqFJVn58Hm3EtS31XFaagaa8VMReCXAkQnJZ+jEy8PCC/iT18dFy95WcExNHFTqLyp72eQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    <!-- Main JS-->
    <script src="~/assets/js/main.js"></script>

    <!-- TinyMCE -->
    <script src="~/js/TinyMce.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

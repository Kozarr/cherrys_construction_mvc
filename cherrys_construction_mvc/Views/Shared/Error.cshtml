@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<!-- ======= Breadcrumbs ======= -->
<div class="breadcrumbs d-flex align-items-center" style="background-image: url('/assets/img/breadcrumbs-bg.jpg');">
    <div class="container position-relative d-flex flex-column align-items-center" data-aos="fade">

        <h2>Error</h2>
        <ol>
            <li><a asp-area="@Breadcrumb.HomeArea" asp-controller="@Breadcrumb.HomeController" asp-action="Index">@Breadcrumb.HomeTitle</a></li>
            <li>Error</li>
        </ol>

    </div>
</div><!-- End Breadcrumbs -->

<div class="container p-4">
    <h1 class="text-danger">Error.</h1>
    <h2 class="text-danger">An error occurred while processing your request.</h2>

    @if (Model.ShowRequestId)
    {
        <p>
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <h3>Oooops...</h3>
    <p>
        We are currently experiencing technical difficulties. If you have any questions or require support, please reach out to our support team at nazar@xurnet.com
    </p>
    <p>
        We value your feedback and appreciate your patience as we work to resolve this issue.
    </p>
</div>

